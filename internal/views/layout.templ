package views

templ Layout(meta PageMeta) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#0a0a0c"/>
			<title>{ meta.Title }</title>
			<meta name="description" content={ meta.Description }/>
			<link rel="canonical" href={ meta.Canonical }/>
			<meta property="og:title" content={ meta.Title }/>
			<meta property="og:description" content={ meta.Description }/>
			<meta property="og:url" content={ meta.Canonical }/>
			<meta property="og:image" content={ meta.ImageURL }/>
			<meta property="og:type" content={ meta.OGType }/>
			<meta name="twitter:card" content="summary_large_image"/>
			<link rel="icon" href="/favicon.ico" sizes="any"/>
			<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
			<link rel="stylesheet" href="/static/css/site.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.8"></script>
		</head>
		<body>
			<a class="skip" href="#main-content">Skip to content</a>
			@Header(meta.Path)
			<main class="wrap" id="main-content">
			{ children... }
			</main>
			@Footer()
			<script src="/static/js/home.js" defer></script>
		</body>
	</html>
}

templ Header(path string) {
	<header class="site-header">
		<nav class="nav-bar wrap" aria-label="Main navigation">
			<a class="brand" href="/" aria-label="Waitaminute Digital home">
				<picture>
					<source srcset="/static/img/logo-128.webp" type="image/webp"/>
					<img class="brand-mark" src="/static/img/logo.png" alt="" width="40" height="40"/>
				</picture>
				<span class="wordmark">WAITAMINUTE</span>
				<span class="badge">EDITORIAL</span>
			</a>
			<input class="nav-toggle sr-only" type="checkbox" id="nav-toggle"/>
			<label class="nav-burger" for="nav-toggle" aria-label="Toggle menu">
				<span class="burger-bar"></span>
				<span class="burger-bar"></span>
				<span class="burger-bar"></span>
			</label>
			<nav class="nav-links" aria-label="Primary navigation">
				@NavLink("Dispatches", "/dispatches", IsCurrent(path, "/dispatches"))
				@NavLink("Game Room", "/game-room", IsCurrent(path, "/game-room"))
				@NavLink("Projects", "/projects", IsCurrent(path, "/projects"))
				@NavLink("About", "/about", IsCurrent(path, "/about"))
				<a class="btn-contact" href="/contact">Contact</a>
			</nav>
		</nav>
	</header>
}

templ NavLink(label string, href string, active bool) {
	if active {
		<a class="nav-link" href={ href } aria-current="page">{ label }</a>
	} else {
		<a class="nav-link" href={ href }>{ label }</a>
	}
}

templ Footer() {
	<footer class="site-footer">
		<div class="footer-bar wrap">
			<p class="copyright">© { CopyrightYear() } Waitaminute Digital</p>
			<nav class="footer-links" aria-label="Social links">
				<a href="https://github.com/CodeToole" target="_blank" rel="noopener noreferrer">GitHub</a>
				<a href="https://www.linkedin.com/in/corneliustoole/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
			</nav>
		</div>
	</footer>
}